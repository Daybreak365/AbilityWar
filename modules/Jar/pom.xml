		<relativePath>../../pom.xml</relativePath>
	</parent>

    <properties>
        <packagedAdapters>v1_12_R1,v1_13_R1,v1_13_R2,v1_14_R1,v1_15_R1,v1_16_R1,v1_16_R2,v1_16_R3,v1_17_R1,v1_19_R1,v1_19_R2,v1_20_R3,v26_3,v1_18_R1,v1_18_R2,v1_19_R3,v1_20_R1,v1_20_R2,v1_20_R4,v1_21_R1,v1_21_R2,v1_21_R3,v1_21_R4,v1_21_R5,v1_21_R6,v1_21_R7,v26_1,v26_2</packagedAdapters>
        <compiledAdapters>v1_17_R1,v1_19_R1,v1_19_R2,v1_20_R3,v26_3,v1_18_R1,v1_18_R2,v1_19_R3,v1_20_R1,v1_20_R2,v1_20_R4,v1_21_R1,v1_21_R2,v1_21_R3,v1_21_R4,v1_21_R5,v1_21_R6,v1_21_R7,v26_1,v26_2</compiledAdapters>
    </properties>

	<repositories>
		<repository>
			<id>spigot-repo</id>
			<url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
		</repository>
		<repository>
			<id>mojang-repo</id>
			<url>https://libraries.minecraft.net/</url>
		</repository>
	</repositories>

	<dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
		<dependency>
			<groupId>kr.daybreak</groupId>
			<artifactId>Plugin</artifactId>
			<version>${revision}</version>
			<scope>compile</scope>
		</dependency>
        <dependency>
            <groupId>kr.daybreak</groupId>
            <artifactId>v26_3</artifactId>
            <version>${revision}</version>
            <scope>compile</scope>
        </dependency>

	</dependencies>

	<build>
        <testSourceDirectory>test</testSourceDirectory>
		<finalName>AbilityWar-${project.version}</finalName>
		<plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <executions>
                    <execution>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <packagedJar>${project.build.directory}/${project.build.finalName}.jar</packagedJar>
                        <packagedAdapters>${packagedAdapters}</packagedAdapters>
                        <compatibilityClasses>${project.basedir}/../compatibility/Compatibility/target/classes</compatibilityClasses>
                        <pluginJar>${project.basedir}/../Plugin/target/Plugin-${project.version}.jar</pluginJar>
                        <compiledAdapters>${compiledAdapters}</compiledAdapters>
                        <adaptersDirectory>${project.basedir}/../compatibility</adaptersDirectory>
                        <artifactVersion>${project.version}</artifactVersion>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
			<plugin>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<artifactSet>
								<includes>
                                    <!-- Plugin already bundles Common, Compatibility and Patch,
                                         with the relocations used by the addon API. The final
                                         distribution only adds version-specific adapters. -->
                                    <include>kr.daybreak:Plugin</include>
                                    <include>kr.daybreak:v*</include>
								</includes>
							</artifactSet>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/**</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

